# Template for local configuration — copy to env.local (git-ignored) and fill in.
# On balena, set the same values as fleet env vars instead:
#   balena env set LOKI_URL "http://loki.example.com:3100/loki/api/v1/push" -f <fleet>
#   balena env set LOKI_EXTERNAL_LABELS "host=my-node,location=homelab,application=serial,container_name={{.Name}}" -f <fleet>

# Loki push endpoint; empty disables forwarding.
LOKI_URL=http://loki.example.com:3100/loki/api/v1/push

# Comma-separated key=value pairs (docker Loki log driver style).
# "{{.Name}}" is replaced with the container name; a "serial_port" label
# (/dev/ttyUSB0, ...) is always added automatically.
LOKI_EXTERNAL_LABELS=host=my-node,location=homelab,application=serial,container_name={{.Name}}

# SSH access to the streams (leave SSH_PASSWORD empty for pubkey-only).
SSH_PASSWORD=
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... user@host
